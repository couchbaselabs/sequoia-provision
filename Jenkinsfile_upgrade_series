// Upgrade series: runs the upgrade pipeline (DOWNSTREAM_JOB, built from ./Jenkinsfile) once per source version,
// one after another, each upgrading to the same final version. Every downstream build is a complete path:
// fresh install of the source version, pre-upgrade test (eagle eye restarted for the cluster), upgrade.sh,
// post-upgrade test. Example: UPGRADE_SOURCE_VERSIONS="7.6.12-6501, 8.0.0-3777" with UPGRADE_CB_VERSION=8.5.0 runs
// 7.6.12-6501 -> 8.5.0, then 8.0.0-3777 -> 8.5.0.
pipeline {
    agent none

    options {
        // Every path reinstalls the same pool: two series on one component would wipe each other's cluster
        disableConcurrentBuilds()
    }

    parameters {
        string(name: 'DOWNSTREAM_JOB', defaultValue: 'System_Longevity_Pipeline_Upgrade',
               description: 'Upgrade pipeline job (sequoia-provision Jenkinsfile) run once per source version')
        choice(name: 'COMPONENT',
               choices: ['component7', 'component3', 'component6', 'mid_scale_component1', 'longevity_cluster_1', 'longevity_cluster_2'],
               description: 'Component pool the paths run on (one after another)')
        string(name: 'UPGRADE_SOURCE_VERSIONS', defaultValue: '',
               description: 'Source versions as VERSION-BUILD, comma or space separated, run in this order, e.g. "7.6.12-6501, 8.0.0-3777"')
        choice(name: 'UPGRADE_MODE', choices: ['online', 'offline'], description: 'Upgrade mode for every path')
        string(name: 'UPGRADE_CB_VERSION', defaultValue: '8.5.0', description: 'Final version every path upgrades to')
        string(name: 'UPGRADE_CB_BUILD', defaultValue: '', description: 'Final build number')
        string(name: 'UPGRADE_CB_INSTALL_URL', defaultValue: '', description: 'Optional install URL for the final version (overrides version/build)')
        string(name: 'UPGRADE_SPARE_HOSTS', defaultValue: '', description: 'Optional spare node IPs for online upgrade (empty: the pool host outside the cluster)')
        string(name: 'TEST_FILE',
               defaultValue: 'tests/upgrade/gsi_query/test_gsi_query_pre_upgrade.yml -scope tests/upgrade/gsi_query/scope_gsi_query_upgrade.yml',
               description: 'Pre-upgrade test (and -scope)')
        string(name: 'POST_UPGRADE_TEST_FILE',
               defaultValue: 'tests/upgrade/gsi_query/test_gsi_query_post_upgrade.yml -scope tests/upgrade/gsi_query/scope_gsi_query_upgrade.yml',
               description: 'Post-upgrade test (and -scope); use the same scope as TEST_FILE')
        string(name: 'SCALE', defaultValue: '1', description: 'Scale parameter for sequoia')
        string(name: 'LOG_LEVEL', defaultValue: '2', description: 'Sequoia log level (2+ shows the tool output)')
        string(name: 'SEQ_PROVISION_BRANCH', defaultValue: 'upgrade-support', description: 'sequoia-provision branch for the downstream builds (needs upgrade.sh)')
        string(name: 'SEQ_REPO_BRANCH', defaultValue: 'master', description: 'sequoia branch for the downstream builds')
        string(name: 'SEQ_CHERRYPICK', defaultValue: '', description: 'Optional cherry-pick command for the sequoia repo')
        string(name: 'DOCKER_CREDS_ID', defaultValue: 'sys_test_docker_cred', description: 'Docker Hub credentials ID')
        booleanParam(name: 'START_EAGLE_EYE', defaultValue: true,
                     description: 'Each path stops the running eagle eye build for the cluster master and starts a fresh one')
        string(name: 'EMAIL_RECIPIENTS', defaultValue: '', description: 'Eagle eye recipients (empty: log parser job default)')
        string(name: 'CONSOLE_CREDS_ID', defaultValue: '',
               description: 'Optional usernamePassword credentials (user + API token) for reading the downstream consoles over REST; empty reads them anonymously')
        booleanParam(name: 'CONTINUE_ON_FAILURE', defaultValue: true,
                     description: 'Run the remaining paths when one fails (each path reinstalls the cluster)')
    }

    stages {
        stage('Upgrade paths') {
            steps {
                script {
                    def sources = parseSources(params.UPGRADE_SOURCE_VERSIONS)
                    if (!params.UPGRADE_CB_VERSION?.trim() || !(params.UPGRADE_CB_BUILD?.trim() || params.UPGRADE_CB_INSTALL_URL?.trim())) {
                        error 'UPGRADE_CB_VERSION and UPGRADE_CB_BUILD (or UPGRADE_CB_INSTALL_URL) are required'
                    }
                    def target = params.UPGRADE_CB_BUILD?.trim() ? "${params.UPGRADE_CB_VERSION}-${params.UPGRADE_CB_BUILD}" : params.UPGRADE_CB_VERSION
                    def labels = []
                    for (int i = 0; i < sources.size(); i++) {
                        labels << sources[i].label
                    }
                    currentBuild.description = "${params.UPGRADE_MODE} | ${params.COMPONENT} | ${labels.join(', ')} -> ${target}"

                    def paths = []
                    for (int i = 0; i < sources.size(); i++) {
                        paths << [label: "${sources[i].label} -> ${target}", source: sources[i].label, result: 'NOT_RUN',
                                  url: '', run: null]
                    }
                    try {
                        for (int i = 0; i < sources.size(); i++) {
                            def src = sources[i]
                            def path = paths[i]
                            stage("${i + 1}/${sources.size()}: ${path.label}") {
                                echo ">>> Upgrade path ${i + 1}/${sources.size()}: ${path.label} (${params.UPGRADE_MODE})"
                                def b = build(job: params.DOWNSTREAM_JOB, wait: true, propagate: false, parameters: [
                                    string(name: 'COMPONENT', value: params.COMPONENT),
                                    booleanParam(name: 'SKIP_INSTALL', value: false),
                                    string(name: 'CB_VERSION', value: src.version),
                                    string(name: 'CB_BUILD', value: src.build),
                                    string(name: 'CB_INSTALL_URL', value: ''),
                                    string(name: 'TEST_FILE', value: params.TEST_FILE),
                                    string(name: 'UPGRADE_MODE', value: params.UPGRADE_MODE),
                                    string(name: 'UPGRADE_CB_VERSION', value: params.UPGRADE_CB_VERSION),
                                    string(name: 'UPGRADE_CB_BUILD', value: params.UPGRADE_CB_BUILD),
                                    string(name: 'UPGRADE_CB_INSTALL_URL', value: params.UPGRADE_CB_INSTALL_URL),
                                    string(name: 'UPGRADE_SPARE_HOSTS', value: params.UPGRADE_SPARE_HOSTS),
                                    string(name: 'POST_UPGRADE_TEST_FILE', value: params.POST_UPGRADE_TEST_FILE),
                                    string(name: 'SCALE', value: params.SCALE),
                                    string(name: 'LOG_LEVEL', value: params.LOG_LEVEL),
                                    string(name: 'SEQ_PROVISION_BRANCH', value: params.SEQ_PROVISION_BRANCH),
                                    string(name: 'SEQ_REPO_BRANCH', value: params.SEQ_REPO_BRANCH),
                                    string(name: 'SEQ_CHERRYPICK', value: params.SEQ_CHERRYPICK),
                                    string(name: 'DOCKER_CREDS_ID', value: params.DOCKER_CREDS_ID),
                                    booleanParam(name: 'START_EAGLE_EYE', value: params.START_EAGLE_EYE),
                                    string(name: 'EMAIL_RECIPIENTS', value: params.EMAIL_RECIPIENTS)
                                ])
                                path.run = b
                                path.result = b.result
                                path.url = b.absoluteUrl
                                echo ">>> ${path.label}: ${path.result} (${path.url})"
                                if (path.result != 'SUCCESS') {
                                    unstable("${path.label} ended ${path.result}")
                                }
                            }
                            if (path.result == 'ABORTED' || (path.result != 'SUCCESS' && !params.CONTINUE_ON_FAILURE)) {
                                break
                            }
                        }
                    } finally {
                        // Built even when a path failed or the series stops early, so what did run is reported
                        stage('Report') {
                            buildReport(paths, target)
                        }
                    }
                }
            }
        }
    }
}

// "7.6.12-6501, 8.0.0-3777" -> [[version: '7.6.12', build: '6501', label: '7.6.12-6501'], ...]
// No regex Matcher or closures here: CPS cannot serialize a Matcher held across the error step
def parseSources(String text) {
    def sources = []
    def entries = (text ?: '').trim().split(/[,\s]+/)
    for (int i = 0; i < entries.length; i++) {
        def entry = entries[i]
        if (!entry) {
            continue
        }
        if (!(entry ==~ /\d+\.\d+\.\d+-\d+/)) {
            error "UPGRADE_SOURCE_VERSIONS entry '${entry}' is not VERSION-BUILD (e.g. 8.0.0-3777)"
        }
        def parts = entry.split('-')
        sources << [version: parts[0], build: parts[1], label: entry]
    }
    if (!sources) {
        error 'UPGRADE_SOURCE_VERSIONS is empty: give at least one VERSION-BUILD, e.g. 7.6.12-6501'
    }
    return sources
}


// ------------------------------------------------------------------ report

// Downstream consoles hold the real outcome: sequoia exits 0 even when a test step fails.
def buildReport(List paths, String target) {
    def agentLabel = [component3: 'component-systest-client-3', component6: 'component-systest-client-6',
                component7: 'component-systest-client-7', mid_scale_component1: 'mid_scale_component-client-1',
                longevity_cluster_1: 'longevity-systest-client-1', longevity_cluster_2: 'longevity-systest-client-2'][params.COMPONENT]
    def reports = []
    node(agentLabel) {
        dir("upgrade_series_report_${env.BUILD_NUMBER}") {
            deleteDir()
            for (int i = 0; i < paths.size(); i++) {
                def path = paths[i]
                def report = [label: path.label, source: path.source, target: target, result: path.result,
                              url: path.url, readError: '']
                if (path.run) {
                    def text = readConsole(path.run)
                    if (text == null) {
                        text = fetchConsole(path.url, "console_${i + 1}.txt")
                    }
                    if (text == null) {
                        report.readError = 'console not readable: set CONSOLE_CREDS_ID (anonymous read was refused), or ' +
                                           'approve RunWrapper.getRawBuild and Run.getLog in script approval'
                    } else {
                        report.putAll(parseConsole(text))
                    }
                }
                report.verdict = verdict(report)
                reports << report
            }
            def meta = [build: env.BUILD_NUMBER, url: env.BUILD_URL, mode: params.UPGRADE_MODE, component: params.COMPONENT]
            writeFile(file: 'upgrade_series_report.html', text: renderHtml(reports, target, meta))
            archiveArtifacts(artifacts: 'upgrade_series_report.html')
        }
    }

    def failed = false
    def lines = []
    for (int i = 0; i < reports.size(); i++) {
        def r = reports[i]
        failed = failed || r.verdict != 'PASSED'
        lines << "${r.label}: ${r.verdict} (build ${r.result}; ${summaryCounts(r)}) ${r.url}"
        if (r.upgrade?.order) {
            lines << "    order: ${r.upgrade.order}"
        }
    }
    echo ">>> Upgrade series summary:\n" + lines.join('\n')
    def reportUrl = "${env.BUILD_URL}artifact/upgrade_series_report.html"
    echo ">>> Report: ${reportUrl}"
    currentBuild.description += " | report: ${reportUrl}"
    if (failed) {
        currentBuild.result = 'FAILURE'
    }
}

@NonCPS
def readConsole(run) {
    try {
        return run.getRawBuild().getLog()
    } catch (Exception e) {
        return null
    }
}

def fetchConsole(String buildUrl, String file) {
    if (!params.CONSOLE_CREDS_ID?.trim()) {
        // This Jenkins lets anonymous users read consoles
        def rc = 1
        withEnv(["CONSOLE_URL=${buildUrl}consoleText", "CONSOLE_FILE=${file}"]) {
            rc = sh(returnStatus: true, script: 'curl -sSf --connect-timeout 15 --max-time 600 -o "$CONSOLE_FILE" "$CONSOLE_URL"')
        }
        return rc == 0 ? readFile(file) : null
    }
    def ok = false
    withCredentials([usernamePassword(credentialsId: params.CONSOLE_CREDS_ID, usernameVariable: 'CONSOLE_USER',
                                      passwordVariable: 'CONSOLE_TOKEN')]) {
        withEnv(["CONSOLE_URL=${buildUrl}consoleText", "CONSOLE_FILE=${file}"]) {
            // The token goes through a curl config file, not argv
            ok = sh(returnStatus: true, script: '''
                set +x
                CFG=$(mktemp)
                trap 'rm -f "$CFG"' EXIT
                chmod 600 "$CFG"
                printf 'user = "%s:%s"\\nconnect-timeout = 15\\nmax-time = 600\\n' "$CONSOLE_USER" "$CONSOLE_TOKEN" > "$CFG"
                curl -sSf -K "$CFG" -o "$CONSOLE_FILE" "$CONSOLE_URL"
            ''') == 0
        }
    }
    return ok ? readFile(file) : null
}

// Phases follow the downstream Jenkinsfile's own markers; tool lines are the gsi_query_upgrade Checks output
// ("INFO [action] passed with N warning(s)", "WARNING|ERROR [action] msg", "action: N failure(s)"), container
// errors are sequoia's "Error occurred on container - image:[args]" (+ "expected error occurred" for expect_error).
@NonCPS
def parseConsole(String text) {
    def phase = 'setup'
    def actions = [:]          // "phase|action" -> [phase, action, passed, warnings (set), errors (set), failed]
    def containers = []        // [phase, image, action, expected, usage, detail]
    def seen = new HashSet()
    def lastContainer = null
    def eagleEye = ''
    def swapOrder = ''
    def finished = ''
    // upgrade.sh output: "Cluster members (version / services):" + member lines, "Swap i/N: out (svc) -> in"
    // (online) or "Node i/N: ip (svc) version" (offline, in place),
    // "Upgrade Complete (mode)" + member lines; progress lines start with [HH:MM:SS]
    def upgrade = [mode: '', target: '', seed: '', before: [], after: [], swaps: [], start: '', end: '',
                   complete: false]
    def members = null
    def memberLine = ~/^\s+(\d+\.\d+\.\d+\.\d+)\s+(\S+)\s+(\S+)\s*$/
    def swapLine = ~/^(?:Swap|Node) (\d+)\/(\d+): (\S+) \(([^)]*)\)(?: -> (\d\S*))?/
    def clockLine = ~/^\[(\d\d:\d\d:\d\d)\]/
    def toolLine = ~/(\d{4}-\d\d-\d\d \d\d:\d\d:\d\d,\d+) (INFO|WARNING|ERROR) \[([a-z_]+)\] (.*)/
    def failureLine = ~/\b([a-z_]+): (\d+) failure\(s\)/
    def containerLine = ~/Error occurred on container - ([^:\[]+(?::[^:\[]+)?):\[(.*?)\]?$/
    for (raw in text.split('\n')) {
        def line = raw.replace('\r', '')
        if (line.contains('>>> Starting Couchbase deployment')) {
            phase = 'install'
        } else if (line.contains('>>> Starting sequoia tests')) {
            phase = (phase == 'upgrade') ? 'post' : 'pre'
        } else if (line =~ />>> Starting (online|offline) upgrade/) {
            phase = 'upgrade'
        }
        if (line.contains('>>> Eagle eye job link:')) {
            eagleEye = line.substring(line.indexOf('http')).trim()
            // Jenkins masks part of the hostname in the console; the log parser job's address is fixed (Jenkinsfile)
            if (eagleEye.contains('*') && eagleEye.contains('/job/')) {
                eagleEye = 'http://172.23.121.80' + eagleEye.substring(eagleEye.indexOf('/job/'))
            }
        }
        if (phase == 'upgrade') {
            def u = line.replaceAll(/\x1B\[[0-9;]*m/, '')
            def mm = (u =~ memberLine)
            if (members != null && mm.find()) {
                members << [host: mm.group(1), version: shortVersion(mm.group(2)), services: mm.group(3)]
            } else if (!(u.trim() ==~ /=+/)) {
                // A member list ends at the first other line (the ==== banner under "Upgrade Complete" is skipped)
                members = null
            }
            def hm = (u =~ /Couchbase (online|offline) upgrade -> (\S+)/)
            if (hm.find()) {
                upgrade.mode = hm.group(1)
                upgrade.target = hm.group(2)
            } else if (u.startsWith('Cluster members (version / services)') && !upgrade.before) {
                members = upgrade.before
            } else if (u.contains('Upgrade Complete (')) {
                members = upgrade.after
                upgrade.complete = true
            } else if (u =~ /^(Swap|Upgrade) order/) {
                swapOrder = u.trim()
                def sm = (u =~ /--swap-seed (\d+)/)
                upgrade.seed = sm.find() ? sm.group(1) : ''
            }
            def sw = (u =~ swapLine)
            if (sw.find()) {
                upgrade.swaps << [n: sw.group(1), of: sw.group(2), out: sw.group(3), services: sw.group(4),
                                  replacement: sw.group(5) ?: 'in place', start: '']
            }
            def cm = (u =~ clockLine)
            if (cm.find()) {
                upgrade.start = upgrade.start ?: cm.group(1)
                if (!upgrade.complete) {
                    upgrade.end = cm.group(1)
                }
                if (upgrade.swaps && !upgrade.swaps[-1].start) {
                    upgrade.swaps[-1].start = cm.group(1)
                }
            }
        }
        if (line.startsWith('Finished: ')) {
            finished = line.substring(10).trim()
        }

        def m = (line =~ toolLine)
        if (m.find()) {
            def key = "${phase}|${m.group(3)}"
            def a = actions[key]
            if (a == null) {
                a = [phase: phase, action: m.group(3), passed: 0, warnings: new LinkedHashSet(),
                     errors: new LinkedHashSet(), failed: false]
                actions[key] = a
            }
            // Sequoia can print a failed container's output twice: every distinct timestamped line counts once
            if (seen.add(m.group(0))) {
                def msg = m.group(4)
                if (m.group(2) == 'ERROR') {
                    a.errors << msg
                    a.failed = true
                } else if (m.group(2) == 'WARNING') {
                    a.warnings << msg
                } else if (msg.startsWith('passed with ')) {
                    a.passed++
                }
            }
            continue
        }
        def f = (line =~ failureLine)
        if (f.find() && !line.contains('Error occurred')) {
            def a = actions["${phase}|${f.group(1)}"]
            if (a != null) {
                a.failed = true
            }
            if (lastContainer != null) {
                lastContainer.detail = f.group(0) + ' (see Failures)'
                lastContainer.summarized = true
            }
            continue
        }
        def c = (line =~ containerLine)
        if (c.find()) {
            def args = c.group(2)
            def am = (args =~ /(?:^|\s)-a\s+(\S+)/)
            lastContainer = [phase: phase, image: c.group(1).trim(), action: am.find() ? am.group(1) : '',
                             args: args.length() > 300 ? args.substring(0, 300) + '...' : args,
                             expected: false, usage: false, summarized: false, detail: '']
            containers << lastContainer
            continue
        }
        if (lastContainer != null) {
            if (line.contains('expected error occurred')) {
                lastContainer.expected = true
            } else if (line =~ /error: (unrecognized arguments|argument |the following arguments are required)/) {
                // A usage error means the image is older than the test YAML: real even under expect_error
                lastContainer.usage = true
                lastContainer.detail = line.substring(line.indexOf('error:')).trim()
            } else if (!lastContainer.summarized && !lastContainer.detail && line =~ /(Error|Exception|error:)/ &&
                       !line.contains('Error occurred')) {
                lastContainer.detail = line.trim().replaceAll(/^[^\x20-\x7e]+/, '')
            }
            if (line.startsWith('[20')) {
                lastContainer = null
            }
        }
    }
    def list = []
    for (a in actions.values()) {
        list << [phase: a.phase, action: a.action, passed: a.passed, warnings: new ArrayList(a.warnings),
                 errors: new ArrayList(a.errors), failed: a.failed]
    }
    // Swap n lasts until swap n+1 starts (the last one until the upgrade's last progress line)
    for (int i = 0; i < upgrade.swaps.size(); i++) {
        def next = (i + 1 < upgrade.swaps.size()) ? upgrade.swaps[i + 1].start : upgrade.end
        upgrade.swaps[i].duration = clockDiff(upgrade.swaps[i].start, next)
    }
    upgrade.duration = clockDiff(upgrade.start, upgrade.end)
    upgrade.order = upgradeOrder(upgrade)
    return [actions: list, containers: containers, eagleEye: eagleEye, swapOrder: swapOrder, finished: finished,
            upgrade: upgrade]
}

// "8.0.2-5503-enterprise" -> "8.0.2-5503"
@NonCPS
def shortVersion(String v) {
    return v.replaceAll(/-(enterprise|community|columnar)$/, '')
}

@NonCPS
def serviceName(String s) {
    def names = [kv: 'KV', n1ql: 'N1QL', index: 'Index', fts: 'FTS', cbas: 'Analytics', eventing: 'Eventing',
                 backup: 'Backup']
    def out = []
    for (x in s.split(',')) {
        out << (names[x.trim()] ?: x.trim())
    }
    return out.join('+')
}

// "06:33:01", "07:10:05" -> "37m 4s" (wraps past midnight)
@NonCPS
def clockDiff(String a, String b) {
    if (!a || !b) {
        return ''
    }
    def secs = { String t -> def p = t.split(':'); Integer.parseInt(p[0]) * 3600 + Integer.parseInt(p[1]) * 60 + Integer.parseInt(p[2]) }
    int d = secs(b) - secs(a)
    if (d < 0) {
        d += 24 * 3600
    }
    return d >= 3600 ? "${(int) (d / 3600)}h ${(int) ((d % 3600) / 60)}m" : "${(int) (d / 60)}m ${d % 60}s"
}

// The node sequence by service (KV -> KV -> ... -> Index -> N1QL): online swaps, or offline in-place upgrades one
// node at a time. Consoles from the earlier all-at-once offline upgrade have no per-node lines.
@NonCPS
def upgradeOrder(Map u) {
    if (u.swaps) {
        def seq = []
        for (sw in u.swaps) {
            seq << serviceName(sw.services)
        }
        return seq.join(' -> ')
    }
    if (u.mode == 'offline' && u.before) {
        def counts = [:]
        for (m in u.before) {
            def name = serviceName(m.services)
            counts[name] = (counts[name] ?: 0) + 1
        }
        def parts = []
        for (e in counts) {
            parts << "${e.value} ${e.key}"
        }
        return "all nodes at once (stop, upgrade, start): ${parts.join(', ')}"
    }
    return ''
}

@NonCPS
def versions(List members) {
    def v = new LinkedHashSet()
    for (m in members) {
        v << m.version
    }
    return v.join(', ')
}

// Problems with the upgrade itself: wrong starting version, not finished, nodes left on another version
@NonCPS
def upgradeProblems(Map r) {
    def u = r.upgrade
    def problems = []
    if (u == null || r.result == 'NOT_RUN') {
        return problems
    }
    if (!u.mode) {
        return ['no upgrade.sh output in the console']
    }
    def wrongBefore = [:]      // version -> hosts
    for (m in u.before) {
        if (m.version != r.source) {
            wrongBefore[m.version] = (wrongBefore[m.version] ?: []) + [m.host]
        }
    }
    for (e in wrongBefore) {
        problems << "${e.value.size()} node(s) were on ${e.key} before the upgrade, not ${r.source}: ${e.value.join(', ')}"
    }
    if (!u.complete) {
        problems << 'upgrade.sh did not report "Upgrade Complete"'
    }
    def wrongAfter = [:]
    for (m in u.after) {
        if (!(m.version == r.target || m.version.startsWith(r.target + '-'))) {
            wrongAfter[m.version] = (wrongAfter[m.version] ?: []) + [m.host]
        }
    }
    for (e in wrongAfter) {
        problems << "${e.value.size()} node(s) are on ${e.key} after the upgrade, not ${r.target}: ${e.value.join(', ')}"
    }
    return problems
}

@NonCPS
def verdict(Map r) {
    if (r.result != 'SUCCESS') {
        return r.result == 'NOT_RUN' ? 'NOT_RUN' : 'FAILED'
    }
    if (r.readError) {
        return 'UNKNOWN'
    }
    if (upgradeProblems(r)) {
        return 'FAILED'
    }
    for (a in r.actions) {
        if (a.failed) {
            return 'FAILED'
        }
    }
    for (c in r.containers) {
        if (!c.expected || c.usage) {
            return 'FAILED'
        }
    }
    // No tool output at all: sequoia LOG_LEVEL below 2 hides container output, so nothing was verified
    return r.actions ? 'PASSED' : 'UNKNOWN'
}

@NonCPS
def summaryCounts(Map r) {
    if (r.actions == null) {
        return r.readError ?: 'not run'
    }
    int failed = 0, warnings = 0, errors = 0
    for (a in r.actions) {
        failed += a.failed ? 1 : 0
        warnings += a.warnings.size()
    }
    for (c in r.containers) {
        errors += (!c.expected || c.usage) ? 1 : 0
    }
    return "${r.actions.size()} checks, ${failed} failed, ${warnings} warnings, ${errors} container errors"
}

@NonCPS
def esc(Object o) {
    return String.valueOf(o ?: '').replace('&', '&amp;').replace('<', '&lt;').replace('>', '&gt;').replace('"', '&quot;')
}

// Plain HTML: Jenkins serves artifacts with a CSP that blocks inline styles and scripts
@NonCPS
def renderHtml(List reports, String target, Map meta) {
    def h = new StringBuilder()
    h.append("<!DOCTYPE html><html><head><meta charset=\"utf-8\"><title>Upgrade series ${esc(meta.build)}</title></head><body>\n")
    h.append("<h1>Upgrade series to ${esc(target)} (${esc(meta.mode)}, ${esc(meta.component)})</h1>\n")
    h.append("<p>Series build: <a href=\"${esc(meta.url)}\">${esc(meta.url)}</a>. ")
    h.append("A path PASSES only when its build succeeded, the cluster went from the source to the target version, ")
    h.append("no tool check failed and no container failed unexpectedly.</p>\n")
    h.append("<table border=\"1\" cellpadding=\"4\" cellspacing=\"0\"><tr><th>#</th><th>From</th><th>To</th><th>Mode</th>")
    h.append("<th>Upgrade order</th><th>Verdict</th><th>Build</th><th>Checks</th><th>Eagle eye</th></tr>\n")
    for (r in reports) {
        def u = r.upgrade ?: [:]
        h.append("<tr><td><a href=\"#p${reports.indexOf(r)}\">${reports.indexOf(r) + 1}</a></td>")
        h.append("<td>${esc(u.before ? versions(u.before) : r.source)}</td>")
        h.append("<td>${esc(u.after ? versions(u.after) : r.target)}</td><td>${esc(u.mode ?: meta.mode)}</td>")
        h.append("<td>${esc(u.order)}${u.seed ? " (seed ${esc(u.seed)})" : ''}</td><td><b>${esc(r.verdict)}</b></td>")
        h.append("<td>${r.url ? "<a href=\"${esc(r.url)}\">${esc(r.result)}</a>" : esc(r.result)}</td>")
        h.append("<td>${esc(summaryCounts(r))}</td>")
        h.append("<td>${r.eagleEye ? "<a href=\"${esc(r.eagleEye)}\">eagle eye</a>" : ''}</td></tr>\n")
    }
    h.append("</table>\n")
    for (r in reports) {
        h.append("<h2 id=\"p${reports.indexOf(r)}\">${esc(r.label)}: ${esc(r.verdict)}</h2>\n")
        if (r.readError) {
            h.append("<p>${esc(r.readError)}</p>\n")
        }
        if (r.actions == null) {
            continue
        }
        if (!r.actions) {
            h.append("<p>No tool check output in the console (sequoia LOG_LEVEL must be 2 or higher).</p>\n")
        }
        def u = r.upgrade ?: [:]
        h.append("<p><b>Versions:</b> ${esc(u.before ? versions(u.before) : r.source)} &rarr; ")
        h.append("${esc(u.after ? versions(u.after) : r.target)} (${esc(u.mode ?: meta.mode)} upgrade")
        h.append("${u.duration ? ", ${esc(u.duration)}" : ''})<br>\n")
        h.append("<b>Upgrade order:</b> ${esc(u.order ?: 'unknown')}${u.seed ? " (--swap-seed ${esc(u.seed)} replays it)" : ''}</p>\n")
        def problems = upgradeProblems(r)
        if (problems) {
            h.append("<h3>Upgrade problems</h3><ul>\n")
            for (p in problems) {
                h.append("<li>${esc(p)}</li>\n")
            }
            h.append("</ul>\n")
        }
        if (u.swaps) {
            h.append("<table border=\"1\" cellpadding=\"4\" cellspacing=\"0\"><tr><th>Step</th><th>Node</th>")
            h.append("<th>Services</th><th>Replaced by</th><th>Started</th><th>Took</th></tr>\n")
            for (sw in u.swaps) {
                h.append("<tr><td>${esc(sw.n)}/${esc(sw.of)}</td><td>${esc(sw.out)}</td><td>${esc(serviceName(sw.services))}</td>")
                h.append("<td>${esc(sw.replacement)}</td><td>${esc(sw.start)}</td><td>${esc(sw.duration)}</td></tr>\n")
            }
            h.append("</table>\n")
        }
        if (u.before || u.after) {
            h.append("<p><b>Topology</b></p><table border=\"1\" cellpadding=\"4\" cellspacing=\"0\"><tr><th>Before</th>")
            h.append("<th>Version</th><th>Services</th><th>After</th><th>Version</th><th>Services</th></tr>\n")
            int rows = Math.max(u.before.size(), u.after.size())
            for (int i = 0; i < rows; i++) {
                def b = i < u.before.size() ? u.before[i] : [:]
                def a = i < u.after.size() ? u.after[i] : [:]
                h.append("<tr><td>${esc(b.host)}</td><td>${esc(b.version)}</td><td>${esc(b.services ? serviceName(b.services) : '')}</td>")
                h.append("<td>${esc(a.host)}</td><td>${esc(a.version)}</td><td>${esc(a.services ? serviceName(a.services) : '')}</td></tr>\n")
            }
            h.append("</table>\n")
        }
        h.append("<table border=\"1\" cellpadding=\"4\" cellspacing=\"0\"><tr><th>Phase</th><th>Check</th><th>Result</th>")
        h.append("<th>Warnings</th><th>Failures</th></tr>\n")
        for (a in r.actions) {
            def result = a.failed ? 'FAILED' : (a.passed > 0 ? 'passed' : 'no result line')
            h.append("<tr><td>${esc(a.phase)}</td><td>${esc(a.action)}</td><td><b>${result}</b></td>")
            h.append("<td>${a.warnings.size()}</td><td>${a.errors.size()}</td></tr>\n")
        }
        h.append("</table>\n")
        def failures = []
        for (a in r.actions) {
            for (e in a.errors) {
                failures << "[${a.phase}] ${a.action}: ${e}"
            }
        }
        if (failures) {
            h.append("<h3>Failures</h3><ul>\n")
            for (f in failures) {
                h.append("<li>${esc(f.length() > 600 ? f.substring(0, 600) + '...' : f)}</li>\n")
            }
            h.append("</ul>\n")
        }
        if (r.containers) {
            h.append("<h3>Container errors</h3><table border=\"1\" cellpadding=\"4\" cellspacing=\"0\"><tr><th>Phase</th>")
            h.append("<th>Image</th><th>Action</th><th>Counts</th><th>Detail</th></tr>\n")
            for (c in r.containers) {
                def counts = c.usage ? 'FAILED (usage error: image older than the test)' :
                             (c.expected ? 'expected (expect_error)' : 'FAILED')
                h.append("<tr><td>${esc(c.phase)}</td><td>${esc(c.image)}</td><td>${esc(c.action)}</td><td>${counts}</td>")
                h.append("<td>${esc(c.detail ?: c.args)}</td></tr>\n")
            }
            h.append("</table>\n")
        }
        def warned = []
        for (a in r.actions) {
            for (w in a.warnings) {
                warned << "[${a.phase}] ${a.action}: ${w}"
            }
        }
        if (warned) {
            h.append("<details><summary>${warned.size()} warnings</summary><ul>\n")
            for (w in warned) {
                h.append("<li>${esc(w.length() > 400 ? w.substring(0, 400) + '...' : w)}</li>\n")
            }
            h.append("</ul></details>\n")
        }
    }
    h.append("</body></html>\n")
    return h.toString()
}

